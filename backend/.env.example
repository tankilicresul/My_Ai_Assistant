# Server & Security
ENVIRONMENT=development
PROJECT_NAME="NexusAI Super-Platform"
SECRET_KEY="nexus_super_secret_jwt_key_change_in_production_32_bytes_min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL) - sqlite fallback supported for local dev
DATABASE_URL=sqlite+aiosqlite:///./nexusai.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexusai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_MEMORIES=user_memories
QDRANT_COLLECTION_DOCUMENTS=document_chunks
QDRANT_COLLECTION_RESEARCH=research_knowledge

# AI Providers & LiteLLM Gateway
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""

# Media Generation (Flux, SDXL, Wan, CogVideoX, Kling, Veo)
FAL_KEY=""
REPLICATE_API_TOKEN=""
KLING_API_KEY=""
VEO_API_KEY=""

# Search API (Deep Research)
TAVILY_API_KEY=""
SERPER_API_KEY=""

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Workspace / Code Sandbox root
SANDBOX_STORAGE_DIR="./sandbox_workspaces"
MEDIA_STORAGE_DIR="./media_storage"
DOCUMENT_STORAGE_DIR="./document_storage"
